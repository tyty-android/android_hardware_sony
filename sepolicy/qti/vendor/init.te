allow init { idd_root_dir idd_rca_dir }:dir mounton;

allow init sysfs_tsp:file rw_file_perms;
allow init vendor_sysfs_graphics:{ file lnk_file } r_file_perms;
allow init vendor_sysfs_graphics:file { write open };

allow init vendor_hal_miscta_default_exec:file { read getattr map execute open };

allow init ta_qmi_service_exec:file { read getattr map execute open };
allow init ta_qmi_service:process { transition siginh rlimitinh };
dontaudit init ta_qmi_service:process noatsecure;

allow init vendor_hal_disp_default_exec:file { read getattr map execute open };

allow init vendor_hal_secd_default_exec:file { read getattr map execute open };
allow init vendor_hal_secd_default:process { transition siginh rlimitinh };
allow init vendor_hal_idd_default_exec:file { read getattr map execute open };

allow init idd_exec:file { read getattr map execute open };

allow init tad_socket:sock_file { write };

allow init keyprovd_exec:file { read getattr map execute open };

allow init hwservicemanager:binder { call transfer };

