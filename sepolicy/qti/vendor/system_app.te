binder_call(system_app, vendor_hal_somc_charger_default)

allow system_app hal_nfc_default:binder call;
allow system_app hal_power_default:binder call;
allow system_app hal_sensors_default:binder call;

allow system_app vendor_hal_disp_hwservice:hwservice_manager find;

allow system_app vendor_hal_miscta_service:service_manager find;

allow system_app vendor_hal_disp_default:binder { call transfer };

allow vendor_hal_disp_default system_app:binder { call transfer };

allow vendor_hal_disp_default system_app:service_manager find;