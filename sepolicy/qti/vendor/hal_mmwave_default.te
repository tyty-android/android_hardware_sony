type hal_mmwave_default, domain;
hal_server_domain(hal_mmwave_default, hal_mmwave)

type hal_mmwave_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_mmwave_default)

hwbinder_use(hal_mmwave_server)
get_prop(hal_mmwave_server, hwservicemanager_prop);

add_hwservice(hal_mmwave_server, hal_mmwave_hwservice)
allow hal_mmwave_hwservice vendor_diag_device:chr_file rw_file_perms;

binder_call(hal_mmwave_default, platform_app)
binder_call(platform_app, hal_mmwave_default)