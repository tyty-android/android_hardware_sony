type hal_ifaa_default, domain;
hal_server_domain(hal_ifaa_default, hal_ifaa)

type hal_ifaa_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_ifaa_default)

hal_client_domain(hal_ifaa_default, hal_allocator)

allow hal_ifaa_default hidl_memory_hwservice:hwservice_manager find;

hwbinder_use(hal_ifaa_server)
get_prop(hal_ifaa_server, hwservicemanager_prop);

add_hwservice(hal_ifaa_server, hal_ifaa_hwservice)

binder_call(hal_ifaa_client, hal_ifaa_server)
binder_call(hal_ifaa_server, hal_ifaa_client)

allow hal_ifaa_hwservice sysfs:chr_file rw_file_perms;

allow untrusted_app_all hal_ifaa_default:binder { call transfer };
allow platform_app hal_ifaa_default:binder { call transfer };
allow priv_app hal_ifaa_default:binder { call transfer };
allow system_app hal_ifaa_default:binder { call transfer };
allow system_server hal_ifaa_default:binder { call transfer };

allow untrusted_app_all hal_ifaa_hwservice:hwservice_manager find;
allow platform_app hal_ifaa_hwservice:hwservice_manager find;
allow priv_app hal_ifaa_hwservice:hwservice_manager find;
allow system_app hal_ifaa_hwservice:hwservice_manager find;
allow system_server hal_ifaa_hwservice:hwservice_manager find;

# Allow access to tee device
allow hal_ifaa_default tee_device:chr_file rw_file_perms;

# Allow access to load firmware images
r_dir_file(hal_ifaa_default, firmware_file)

# Allow access to interract with ion_device
allow hal_ifaa_default ion_device:chr_file r_file_perms;

#DMA Buf
allow vendor_hal_drm_widevine vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow vendor_hal_drm_widevine vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
